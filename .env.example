# =======================================================
# TRISHULI FLOOD & LANDSLIDE EARLY WARNING SYSTEM - CONFIGURATION
# Copy to .env and fill in. .env is git-ignored.
# =======================================================

# --- DATABASE ---
# Default: SQLite file inside the project folder (zero setup)
DATABASE_URL=sqlite:///./flood_system.db
# Local / hosted PostgreSQL (Supabase, Neon, ...):
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# --- MQTT ---
# The public HiveMQ broker is open to everyone. Give the topics a private random prefix
# (and use broker credentials on a private broker) so strangers cannot inject readings.
MQTT_BROKER=broker.hivemq.com
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_TELEMETRY=nepal/trishuli-CHANGE_ME/sensors/#
MQTT_TOPIC_CONTROL=nepal/trishuli-CHANGE_ME/control/spike

# --- SECURITY ---
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
DEFAULT_OPERATOR_USERNAME=operator
DEFAULT_OPERATOR_PASSWORD=
# Set false on a real deployment to disable the spike / reset demo endpoints
DEMO_CONTROLS_ENABLED=true
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- SENSOR HEALTH ---
# A station silent for longer than this is shown as STALE instead of its last risk level
STALE_AFTER_SECONDS=60

# --- NOTIFICATIONS ---
# Email: simulated | smtp
EMAIL_PROVIDER=simulated
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# false only for a local test server without TLS
SMTP_STARTTLS=true
