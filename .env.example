# =======================================================
# FLOOD & LANDSLIDE EARLY WARNING SYSTEM - CONFIGURATION
# =======================================================

# --- DATABASE SELECTION ---
# Option 1: SQLite (Default zero-config local storage)
DATABASE_URL=sqlite:///./flood_system.db

# Option 2: Local PostgreSQL
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/flood_warning_db

# Option 3: Cloud Hosted PostgreSQL (Neon, Supabase, Render, Aiven)
# DATABASE_URL=postgresql://user:password@ep-cool-mountain.neon.tech/flood_warning_db?sslmode=require

# --- MQTT BROKER CONFIGURATION ---
MQTT_BROKER=broker.hivemq.com
MQTT_PORT=1883
MQTT_TOPIC_TELEMETRY=nepal/trishuli/sensors/#
MQTT_TOPIC_CONTROL=nepal/trishuli/control/spike

# --- ANOMALY DETECTION HYPERPARAMETERS ---
EMA_WINDOW_SIZE=12
SOIL_MOISTURE_SAT_THRESHOLD=40.0
